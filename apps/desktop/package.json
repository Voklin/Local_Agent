{
  "name": "local-coding-agent-desktop",
  "version": "6.0.0",
  "private": true,
  "description": "Electron + React + TypeScript desktop UI for Local Coding Agent",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:electron && wait-on tcp:127.0.0.1:5173 && electron .",
    "build:electron": "node build-electron.mjs",
    "build": "npm run typecheck && vite build && node build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "45.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2"
  }
}

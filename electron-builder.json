{
  "appId": "io.localagent.desktop",
  "productName": "Neutral",
  "directories": {
    "app": "apps/desktop",
    "output": "artifacts/windows"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "tools/tts",
      "to": "tts",
      "filter": [
        "*.py",
        "*.ps1",
        "*.txt",
        "*.md"
      ]
    },
    {
      "from": "build/core/lca-core",
      "to": "core",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/windows-deps/llama",
      "to": "runtime/llama",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "assets/neutral.png",
      "to": "brand/neutral.png"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "signExecutable": false,
    "icon": "assets/neutral.ico"
  },
  "artifactName": "Neutral-${version}-setup-${arch}.${ext}",
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "packaging/prerequisites.nsh"
  }
}

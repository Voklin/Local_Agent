{
  "name": "local-coding-agent-v6-workspace",
  "private": true,
  "version": "6.0.1",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "docs:generate": "python tools/generate_code_reference.py",
    "docs:check": "python tools/check_docs.py",
    "package:win": "npm run build && electron-builder --config electron-builder.json --win --x64 --publish never"
  }
}
